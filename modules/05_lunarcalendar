<div class="bento-item span-2x2 hover-pink" style="display: flex; flex-direction: column; padding: 15px; position: relative; overflow: hidden; box-sizing: border-box; background-color: var(--box-bg);">
    <style>
        .cyber-lunar-cal {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            font-family: monospace;
        }
        .cyber-lunar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            color: var(--neon-pink);
            font-weight: bold;
            font-size: 1.1rem;
            border-bottom: 1px solid rgba(255, 0, 60, 0.3);
            padding-bottom: 8px;
            text-shadow: 0 0 5px rgba(255, 0, 60, 0.4);
        }
        .cyber-lunar-btn {
            background: transparent;
            border: 1px solid var(--text-muted);
            color: var(--text-main);
            cursor: pointer;
            padding: 2px 10px;
            border-radius: 2px;
            transition: all 0.2s ease;
            font-family: monospace;
            outline: none;
        }
        .cyber-lunar-btn:hover {
            border-color: var(--neon-pink);
            color: var(--neon-pink);
            box-shadow: 0 0 8px rgba(255, 0, 60, 0.5);
            background: rgba(255, 0, 60, 0.1);
        }
        .cyber-lunar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
            flex-grow: 1;
            text-align: center;
        }
        .cyber-lunar-day-name {
            color: var(--text-muted);
            font-size: 0.75rem;
            padding-bottom: 5px;
            letter-spacing: 1px;
        }
        .cyber-lunar-date {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 1px solid transparent;
            border-radius: 2px;
            transition: border 0.2s, color 0.2s, background 0.2s;
            aspect-ratio: 1 / 1;
            position: relative;
        }
        .cyber-lunar-gregorian {
            color: var(--text-muted);
            font-size: 0.65rem;
            line-height: 1;
            margin-bottom: 2px;
        }
        .cyber-lunar-text {
            color: var(--text-main);
            font-size: 0.85rem;
            line-height: 1;
            font-weight: bold;
        }
        .cyber-lunar-date.today {
            background: var(--neon-cyan);
            border-color: var(--neon-cyan);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
        }
        .cyber-lunar-date.today .cyber-lunar-gregorian,
        .cyber-lunar-date.today .cyber-lunar-text {
            color: var(--bg-color);
        }
        .cyber-lunar-date.active-hover:hover {
            border-color: var(--neon-pink);
            background: rgba(255, 0, 60, 0.1);
            cursor: crosshair;
        }
        .cyber-lunar-date.active-hover:hover .cyber-lunar-text {
            color: var(--neon-pink);
            text-shadow: 0 0 5px rgba(255, 0, 60, 0.6);
        }
        .cyber-lunar-date.empty {
            pointer-events: none;
        }
        .lunar-month-start {
            color: var(--neon-cyan); 
        }
    </style>

    <div class="cyber-lunar-cal" id="lunar-calendar-app">
        <div class="cyber-lunar-header">
            <button class="cyber-lunar-btn" id="lunar-cal-prev">◀</button>
            <span id="lunar-cal-title">SYS.LUNAR_CAL</span>
            <button class="cyber-lunar-btn" id="lunar-cal-next">▶</button>
        </div>
        <div class="cyber-lunar-grid" id="lunar-cal-days-header">
            <div class="cyber-lunar-day-name">日</div>
            <div class="cyber-lunar-day-name">一</div>
            <div class="cyber-lunar-day-name">二</div>
            <div class="cyber-lunar-day-name">三</div>
            <div class="cyber-lunar-day-name">四</div>
            <div class="cyber-lunar-day-name">五</div>
            <div class="cyber-lunar-day-name">六</div>
        </div>
        <div class="cyber-lunar-grid" id="lunar-cal-dates">
            </div>
    </div>

    <script>
        (function() {
            const titleEl = document.getElementById('lunar-cal-title');
            const datesEl = document.getElementById('lunar-cal-dates');
            const prevBtn = document.getElementById('lunar-cal-prev');
            const nextBtn = document.getElementById('lunar-cal-next');

            let currentDate = new Date(); 
            const today = new Date(); 

            // 核心：利用浏览器原生 Intl API 提取农历信息
            function getLunarData(date) {
                try {
                    // 获取农历日期（如：初一、十五）
                    const dayFormatter = new Intl.DateTimeFormat('zh-CN-u-ca-chinese', { day: 'numeric' });
                    let lunarDay = dayFormatter.format(date);
                    
                    // 获取农历月份（如：正月、冬月）
                    const monthFormatter = new Intl.DateTimeFormat('zh-CN-u-ca-chinese', { month: 'short' });
                    let lunarMonth = monthFormatter.format(date);

                    // 兼容某些浏览器返回阿拉伯数字的问题
                    const numMap = ['〇','一','二','三','四','五','六','七','八','九','十','十一','十二','十三','十四','十五','十六','十七','十八','十九','二十','廿一','廿二','廿三','廿四','廿五','廿六','廿七','廿八','廿九','三十'];
                    if (!isNaN(parseInt(lunarDay))) lunarDay = numMap[parseInt(lunarDay)] || lunarDay;
                    if (lunarDay === '一') lunarDay = '初一'; // 特殊修正

                    // 如果是初一，显示月份
                    if (lunarDay === '初一' || lunarDay === '1') {
                        return { text: lunarMonth, isMonthStart: true };
                    }
                    return { text: lunarDay, isMonthStart: false };
                } catch (e) {
                    return { text: 'ERR', isMonthStart: false }; // 防崩回退
                }
            }

            function renderCalendar() {
                const year = currentDate.getFullYear();
                const month = currentDate.getMonth();

                const monthNames = ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"];
                titleEl.textContent = `${year} / ${monthNames[month]}`;

                datesEl.innerHTML = '';

                const firstDayOfMonth = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                // 填充上个月留白
                for (let i = 0; i < firstDayOfMonth; i++) {
                    const emptyDiv = document.createElement('div');
                    emptyDiv.className = 'cyber-lunar-date empty';
                    datesEl.appendChild(emptyDiv);
                }

                // 渲染当月数据矩阵
                for (let i = 1; i <= daysInMonth; i++) {
                    const iterDate = new Date(year, month, i);
                    const lunarInfo = getLunarData(iterDate);

                    const dateDiv = document.createElement('div');
                    dateDiv.className = 'cyber-lunar-date active-hover';

                    // 阳历微型数字
                    const gregSpan = document.createElement('span');
                    gregSpan.className = 'cyber-lunar-gregorian';
                    gregSpan.textContent = i;

                    // 农历高亮文本
                    const lunarSpan = document.createElement('span');
                    lunarSpan.className = 'cyber-lunar-text';
                    if (lunarInfo.isMonthStart) {
                        lunarSpan.classList.add('lunar-month-start');
                    }
                    lunarSpan.textContent = lunarInfo.text;

                    dateDiv.appendChild(gregSpan);
                    dateDiv.appendChild(lunarSpan);

                    // 今日高亮 (赛博青)
                    if (year === today.getFullYear() && month === today.getMonth() && i === today.getDate()) {
                        dateDiv.classList.add('today');
                        dateDiv.classList.remove('active-hover');
                    }

                    datesEl.appendChild(dateDiv);
                }
            }

            prevBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar();
            });

            nextBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar();
            });

            // 启动引擎
            renderCalendar();
        })();
    </script>
</div>