<div class="bento-item hover-cyan" style="display: flex; flex-direction: column; padding: 12px; position: relative; overflow: hidden; box-sizing: border-box; background-color: var(--box-bg);">
    <style>
        .cyber-epl-app {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            font-family: monospace;
        }
        .cyber-epl-header {
            color: var(--neon-cyan);
            font-weight: bold;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(0, 240, 255, 0.3);
            padding-bottom: 6px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-shadow: 0 0 5px rgba(0, 240, 255, 0.4);
        }
        .cyber-epl-live-dot {
            width: 6px;
            height: 6px;
            background-color: var(--neon-pink);
            border-radius: 50%;
            box-shadow: 0 0 5px var(--neon-pink);
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.2); }
            100% { opacity: 1; transform: scale(1); }
        }
        .cyber-epl-list {
            flex-grow: 1;
            overflow-y: auto;
            padding-right: 4px;
        }
        /* 骇客风自定义滚动条 */
        .cyber-epl-list::-webkit-scrollbar {
            width: 2px;
        }
        .cyber-epl-list::-webkit-scrollbar-thumb {
            background: var(--neon-cyan);
        }
        .cyber-epl-match {
            margin-bottom: 6px;
            border: 1px solid rgba(139, 148, 158, 0.2);
            border-radius: 2px;
            background: rgba(13, 17, 23, 0.5);
        }
        .cyber-epl-match summary {
            cursor: pointer;
            color: var(--text-main);
            font-size: 0.75rem;
            padding: 6px;
            list-style: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }
        /* 隐藏原生折叠箭头 */
        .cyber-epl-match summary::-webkit-details-marker {
            display: none;
        }
        .cyber-epl-match summary:hover {
            background: rgba(0, 240, 255, 0.1);
            color: var(--neon-cyan);
        }
        .cyber-epl-match details[open] summary {
            border-bottom: 1px dashed rgba(0, 240, 255, 0.3);
            color: var(--neon-cyan);
        }
        .epl-team {
            font-weight: bold;
            letter-spacing: 0.5px;
        }
        .epl-time {
            color: var(--text-muted);
            font-size: 0.65rem;
        }
        .cyber-epl-detail {
            font-size: 0.65rem;
            color: var(--text-muted);
            padding: 6px;
            background: rgba(0, 0, 0, 0.2);
            line-height: 1.4;
        }
        .cyber-epl-detail span {
            color: var(--neon-purple);
        }
    </style>

    <div class="cyber-epl-app">
        <div class="cyber-epl-header">
            <span>⚽ SYS.EPL_DATA</span>
            <div class="cyber-epl-live-dot"></div>
        </div>
        <div class="cyber-epl-list" id="epl-data-mount">
            </div>
    </div>

    <script>
        (function() {
            // 模拟赛程数据 (使用缩写以节省空间)
            const matches = [
                { home: 'ARS', away: 'MCI', time: 'Sat 23:00', loc: 'Emirates', ref: 'M. Oliver' },
                { home: 'LIV', away: 'CHE', time: 'Sun 01:30', loc: 'Anfield', ref: 'A. Taylor' },
                { home: 'MUN', away: 'TOT', time: 'Sun 22:00', loc: 'Old Trafford', ref: 'P. Tierney' },
                { home: 'NEW', away: 'AST', time: 'Mon 03:00', loc: 'St James', ref: 'S. Hooper' }
            ];

            const mountPoint = document.getElementById('epl-data-mount');

            // 渲染列表
            matches.forEach(match => {
                const detailsEl = document.createElement('details');
                detailsEl.className = 'cyber-epl-match';
                
                detailsEl.innerHTML = `
                    <summary>
                        <div class="epl-team">${match.home} vs ${match.away}</div>
                        <div class="epl-time">${match.time}</div>
                    </summary>
                    <div class="cyber-epl-detail">
                        <div>> LOC: <span>${match.loc}</span></div>
                        <div>> REF: <span>${match.ref}</span></div>
                        <div>> STATUS: <span>AWAITING</span></div>
                    </div>
                `;
                
                mountPoint.appendChild(detailsEl);
            });
        })();
    </script>
</div>